rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public can read published content only. Any authenticated user (i.e.
    // the single admin account) can read/write everything, including drafts.
    // If a second admin is ever added, tighten `request.auth != null` to a
    // check against an `admins/{uid}` allow-list document instead.

    match /posts/{postId} {
      allow read: if resource.data.published == true || request.auth != null;
      allow write: if request.auth != null;
    }

    match /projects/{projectId} {
      allow read: if resource.data.published == true || request.auth != null;
      allow write: if request.auth != null;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
